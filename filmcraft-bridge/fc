def add_common(parser, with_defaults):
    """Shared flags.

    Subparsers must use default=SUPPRESS. A real default on the subparser
    replaces a flag the user already passed before the command name, which
    sent --port and --offline back to 9877 / live mode.
    """
    def d(value):
        return value if with_defaults else argparse.SUPPRESS
    parser.add_argument("-p", "--project", default=d(os.environ.get("FC_PROJECT")))
    parser.add_argument("--port", type=int, default=d(int(os.environ.get("FC_PORT") or os.environ.get("FILMCRAFT_CONTROL_PORT") or 9877)))
    parser.add_argument("--host", default=d("127.0.0.1"))
    parser.add_argument("--token", default=d(None), help="64 hex chars; else FILMCRAFT_CONTROL_TOKEN or %%TEMP%%\\fc1104.tok")
    parser.add_argument("--offline", action="store_true", default=d(False), help="edit the .fcproj even if FilmCraft is running")
    parser.add_argument("--no-git", action="store_true", default=d(False))

def build_parser():
    p = argparse.ArgumentParser(prog="fc", description=__doc__)
    add_common(p, True)
    sub = p.add_subparsers(dest="cmd", required=True)
    def add(name, fn, **kw):
        x = sub.add_parser(name, help=kw.get("help"))
        add_common(x, False)
        x.set_defaults(fn=fn)
        return x
    x = add("new", cmd_new, help="create a project and a sequence")
    x.add_argument("name"); x.add_argument("--sequence"); x.add_argument("--width", type=int, default=1920)
    x.add_argument("--height", type=int, default=1080); x.add_argument("--fps", type=float, default=24)
    x.add_argument("--video", type=int, default=2); x.add_argument("--audio", type=int, default=3)
    x = add("open", cmd_open); x.add_argument("path")
    x = add("save", cmd_save); x.add_argument("path", nargs="?"); x.add_argument("--save-as", action="store_true")
    x = add("import", cmd_import, help="import media into the open project")
    x.add_argument("paths", nargs="+"); x.add_argument("--name"); x.add_argument("--bin", type=int)
    x.add_argument("--probe"); x.add_argument("--duration", type=float); x.add_argument("--width", type=int)
    x.add_argument("--height", type=int); x.add_argument("--fps", type=float); x.add_argument("--sr", type=int, default=48000)
    x.add_argument("--channels", type=int, default=2); x.add_argument("--size", type=int)
    x.add_argument("--no-audio", action="store_true"); x.add_argument("--local", action="store_true", help="send absolute paths (offline import)")
    x = add("media", cmd_import, help="alias of import")
    x.add_argument("paths", nargs="+"); x.add_argument("--name"); x.add_argument("--bin", type=int)
    x.add_argument("--probe"); x.add_argument("--duration", type=float); x.add_argument("--width", type=int)
    x.add_argument("--height", type=int); x.add_argument("--fps", type=float); x.add_argument("--sr", type=int, default=48000)
    x.add_argument("--channels", type=int, default=2); x.add_argument("--size", type=int)
    x.add_argument("--no-audio", action="store_true"); x.add_argument("--local", action="store_true")
    x = add("add-clips", cmd_add); x.add_argument("items", type=int, nargs="+"); x.add_argument("--vtrack", default="V1")
    x.add_argument("--atrack", default="A1"); x.add_argument("--at", type=float); x.add_argument("--dur", type=float)
    x.add_argument("--fill", action="store_true"); x.add_argument("--clip-db", type=float, default=0.0)

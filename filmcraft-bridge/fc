        result = client.execute("timeline.trim", {"clip": args.clip, "edge": args.edge, "mode": args.mode, "deltaFrames": args.frames})
        emit({"via": "control", "trim": result})
        return
    project = load_project(args.project)
    seq, _ = active_sequence(project)
    step = frame_ticks(seq["settings"]["frame_rate"]) * args.frames
    for track in seq["video_tracks"] + seq["audio_tracks"]:
        for clip in track["items"]:
            if clip["id"] != args.clip:
                continue
            if args.edge == "in":
                clip["start"] += step
                clip["duration"] -= step
                if not clip["reverse"]:
                    clip["source_in"] += step
            else:
                clip["duration"] += step
            if clip["duration"] <= 0:
                fail("trim would remove the clip")
            save_project(args, project, "fc trim %s" % args.clip)
            warn_offline()
            emit({"via": "file", "clip": args.clip, "duration": clip["duration"]})
            return
    fail("no clip %s" % args.clip)


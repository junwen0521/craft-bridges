def main(argv=None):
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except Exception:
        pass
    args = build_parser().parse_args(argv)
    if getattr(args, "frames", None) is None and getattr(args, "dur", None) and args.cmd == "transition":
        args.frames = max(1, int(round(args.dur * (args.fps if hasattr(args, "fps") and args.fps else 24))))
    if args.cmd == "transition" and args.frames is None:
        args.frames = max(1, int(round(args.dur * 24)))
    client = None
    if not args.offline and port_open(args.host, args.port):
        client = Client(args.host, args.port, load_token(args.token))
    try:
        args.fn(args, client)
    except Offline:
        fail("the control port closed while the command was running")
    except ControlError as e:
        fail(e)
    except BrokenPipeError:
        fail("the control port closed the connection")

if __name__ == "__main__":
    main()

def cmd_batch(args, client):
    if not client:
        fail("batch needs FilmCraft listening on the control port")
    steps = json.load(open(args.file, encoding="utf-8"))
    try:
        result = client.call("engine.batch", {"steps": steps, "stopOnError": not args.keep_going})
        emit({"via": "control", "batch": result})
        return
    except ControlError as e:
        if "unknown method" not in str(e):
            fail(e)
    results = []
    failed = 0
    for step in steps:
        command = step.get("command") or step.get("id")
        try:
            results.append({"ok": True, "command": command, "result": client.execute(command, step.get("params") or {})})
        except ControlError as e:
            failed += 1
            results.append({"ok": False, "command": command, "error": str(e)})
            if not args.keep_going:
                break
    emit({"via": "control", "batch": {"completed": len(results) - failed, "failed": failed, "results": results, "fallback": "engine.execute"}})


#!/usr/bin/env python3
"""fc — drive FilmCraft from the command line.

The running app (filmcraft --control, default 127.0.0.1:9877) is the editor.
Every change is an engine command, so the open timeline updates without a
reload. The project file is edited only when that port is closed, or when
--offline is set. See API.md.
"""
import argparse, json, os, socket, subprocess, sys
from fractions import Fraction

TPS = 254016000000
HERE = os.path.dirname(os.path.realpath(__file__))
SCHEMA_VERSION = 15

class Offline(Exception):
    pass

class ControlError(Exception):
    pass

def ticks(sec):
    return int(round(Fraction(str(sec)) * TPS))

def snap(n, fps):
    f = Fraction(int(fps["num"]), int(fps["den"]))
    return int(round(Fraction(n) * f / TPS) * TPS / f)

def frame_ticks(fps):
    return int(TPS * int(fps["den"]) / int(fps["num"]))

def hex64(s):
    return isinstance(s, str) and len(s) == 64 and all(c in "0123456789abcdefABCDEF" for c in s)

def load_token(explicit):
    if explicit and hex64(explicit.strip()):
        return explicit.strip()
    env = os.environ.get("FILMCRAFT_CONTROL_TOKEN", "").strip()
    if hex64(env):
        return env
    temp = os.environ.get("TEMP") or os.environ.get("TMP") or ""
    names = ["fc1104.tok", "filmcraft.tok", "filmcraft-control.tok"]
    paths = [os.path.join(temp, n) for n in names] if temp else []
    if temp and os.path.isdir(temp):
        paths += [os.path.join(temp, n) for n in os.listdir(temp) if n.lower().endswith(".tok")]
    seen = set()
    for path in paths:
        if path in seen or not os.path.isfile(path):
            continue
        seen.add(path)
        try:
            text = open(path, encoding="utf-8").read().strip()
        except OSError:
            continue
        if hex64(text):
            return text
    return ""

def port_open(host, port):
    try:
        s = socket.create_connection((host, port), 0.4)
    except OSError:
        return False
    s.close()
    return True

class Client:
    def __init__(self, host, port, token, timeout=60):
        self.host, self.port, self.token, self.timeout = host, port, token, timeout

    def call(self, method, params=None):
        if not self.token:
            raise ControlError("FilmCraft is listening but no 64-hex control token was found (FILMCRAFT_CONTROL_TOKEN or %TEMP%\\fc1104.tok)")
        body = {"id": 1, "token": self.token, "method": method, "params": params or {}}
        try:
            sock = socket.create_connection((self.host, self.port), self.timeout)
        except ConnectionRefusedError:
            raise Offline()
        except OSError as e:
            if getattr(e, "winerror", None) in (10061, 10060) or e.errno in (111, 61):
                raise Offline()
            raise
        try:
            sock.settimeout(self.timeout)
            f = sock.makefile("rwb")
            f.write((json.dumps(body, ensure_ascii=False) + "\n").encode("utf-8"))
            f.flush()
            line = f.readline()
        finally:
            sock.close()
        if not line:
            raise ControlError("control port closed the connection without a reply")
        try:
            reply = json.loads(line.decode("utf-8"))
        except json.JSONDecodeError as e:
            raise ControlError("control port returned non-JSON: %s" % e)
        if not reply.get("ok"):
            raise ControlError(reply.get("error") or "command failed")
        return reply.get("result")

    def execute(self, command, params=None):
        return self.call("engine.execute", {"command": command, "params": params or {}})

def emit(result):
    print(json.dumps({"ok": True, "result": result}, ensure_ascii=False))

def fail(message):
    print(json.dumps({"ok": False, "error": str(message)}, ensure_ascii=False))
    raise SystemExit(1)

def parse_value(text):
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return text

def nest_key(obj, key, value):
    parts = key.split(".")
    cur = obj
    for part in parts[:-1]:
        cur = cur.setdefault(part, {})
    cur[parts[-1]] = value

# ---------- project file (only when the app is not listening) ----------

def load_project(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)

def save_project(args, project, message):
    folder = os.path.dirname(os.path.abspath(args.project)) or "."
    os.makedirs(folder, exist_ok=True)
    tmp = args.project + ".tmp"
    with open(tmp, "w", encoding="utf-8", newline="\n") as f:
        json.dump(project, f, ensure_ascii=False, separators=(",", ":"))
    os.replace(tmp, args.project)
    if not args.no_git:
        if not os.path.isdir(os.path.join(folder, ".git")):
            subprocess.run(["git", "init", "-q", folder], check=False)
        git = ["git", "-C", folder, "-c", "user.name=FilmCraft管家", "-c", "user.email=bot@local"]
        subprocess.run(git + ["add", os.path.basename(args.project)], check=False)
        subprocess.run(git + ["commit", "-q", "-m", message], check=False)

def alloc(project):
    n = project["project"]["next_id"]
    project["project"]["next_id"] = n + 1
    return n

def active_sequence(project):
    view = project.get("view") or {}
    sid = view.get("active_sequence")
    if sid is None:
        for item in project["project"]["items"].values():
            if "Sequence" in item["kind"]:
                sid = item["id"]
                break
    if sid is None:
        fail("the project has no sequence")
    return project["project"]["items"][str(sid)]["kind"]["Sequence"], sid

def find_track(seq, name):
    want = name
    for track in seq["video_tracks"] + seq["audio_tracks"]:
        short = track["name"].replace("Video ", "V").replace("Audio ", "A")
        if track["name"] == want or short == want or str(track["id"]) == str(want):
            return track
    fail("no track %s" % name)

def video_effects(width, height, anchor, scale):
    def pv(kind, value):
        return {"value": {kind: value}}
    return [
        {"effect": "motion", "enabled": True, "params": {
            "anchor": pv("Vec2", {"x": anchor[0], "y": anchor[1]}),
            "anti_flicker": pv("Float", 0.0),
            "position": pv("Vec2", {"x": width / 2, "y": height / 2}),
            "rotation": pv("Float", 0.0),
            "scale": pv("Float", scale),
            "scale_width": pv("Float", 100.0),
            "uniform_scale": pv("Bool", True),
        }},
        {"effect": "opacity", "enabled": True, "params": {
            "blend": pv("Choice", 0), "opacity": pv("Float", 100.0),
        }},
        {"effect": "time_remap", "enabled": True, "params": {"speed": pv("Float", 100.0)}},
    ]

def audio_effects():
    def pv(kind, value):
        return {"value": {kind: value}}
    return [
        {"effect": "volume", "enabled": True, "params": {"bypass": pv("Bool", False), "level": pv("Float", 0.0)}},
        {"effect": "channel_volume", "enabled": True, "params": {
            "bypass": pv("Bool", False), "left": pv("Float", 0.0), "right": pv("Float", 0.0),
        }},
        {"effect": "panner", "enabled": True, "params": {"balance": pv("Float", 0.0)}},
    ]

def new_track(project, kind, n):
    return {
        "id": alloc(project), "kind": kind, "name": "%s %d" % (kind, n), "items": [], "transitions": [],
        "locked": False, "sync_lock": True, "enabled": True, "muted": False, "solo": False,
        "channels": "Stereo", "volume_db": 0.0, "pan": 0.0, "effects": [],
        "mixer": {"mode": "Read", "output": None, "record_arm": False, "solo_safe": False, "input_map": "Stereo"},
    }

def blank_project(name, width, height, fps, video_n, audio_n, sequence_name):
    rate = {"num": int(fps), "den": 1} if float(fps) == int(fps) else {"num": int(round(float(fps) * 1000)), "den": 1000}
    project = {
        "format": "filmcraft.project", "schema_version": SCHEMA_VERSION, "generator": "FilmCraft 0.15.0",
        "project": {
            "name": name,
            "settings": {
                "renderer": "FilmCraft GPU Acceleration (wgpu)", "video_display": "Timecode",
                "audio_display_samples": True, "default_still_duration": 5 * TPS,
                "default_transition_duration_frames": 24, "default_audio_transition_duration": TPS,
                "ingest": {"enabled": False, "action": "createProxies", "destination": None, "preset": ""},
                "title_safe": [20.0, 20.0], "action_safe": [10.0, 10.0], "capture_format": "DV",
                "scratch": {"captured": None, "videoPreviews": None, "audioPreviews": None, "autoSave": None},
            },
            "root": {"id": 0, "name": name, "children": []}, "items": {}, "next_id": 1,
        },
    }
    seq = {
        "settings": {
            "width": width, "height": height, "frame_rate": rate, "par": [1, 1], "sample_rate": 48000,
            "drop_frame": False, "preset": "%dx%d %s" % (width, height, ("%g" % float(fps))),
            "audio_master": "Stereo", "preview_codec": "ProRes 422", "max_bit_depth": False,
            "max_render_quality": False, "working_space": "Rec. 709",
            "color": {"working": "Rec709", "wide_gamut": False, "auto_tone_map": True},
        },
        "video_tracks": [new_track(project, "Video", i + 1) for i in range(video_n)],
        "audio_tracks": [new_track(project, "Audio", i + 1) for i in range(audio_n)],
        "markers": [], "mark_in": None, "mark_out": None, "work_area": None, "start_timecode": 0,
        "master_volume_db": 0.0, "master_effects": [],
        "master_mixer": {"mode": "Read", "output": None, "record_arm": False, "solo_safe": False, "input_map": "Stereo"},
        "submix_tracks": [], "caption_tracks": [],
    }
    sid = alloc(project)
    project["project"]["items"][str(sid)] = {
        "id": sid, "name": sequence_name or name, "label": "Forest", "kind": {"Sequence": seq}, "metadata": {}, "created": sid,
    }
    project["project"]["root"]["children"].append({"Item": sid})
    project["view"] = {"open_sequences": [sid], "active_sequence": sid, "sequences": {}}
    return project

def make_clip(project, item, start, dur, source_in, effects, link, name=None):
    src = project["project"]["items"][str(item)]
    return {
        "id": alloc(project), "item": item, "name": name or src["name"], "label": src["label"],
        "start": start, "duration": dur, "source_in": source_in, "speed": 1.0, "reverse": False,
        "enabled": True, "link": link, "group": None, "effects": effects, "markers": [],
        "gain_db": 0.0, "frame_hold": None, "scale_to_frame": False,
    }

def transition(project, start, dur, left, right, align, effect):
    return {
        "id": alloc(project),
        "effect": {"effect": effect, "enabled": True, "params": {}},
        "start": start, "duration": dur, "from": left, "to": right, "align": align, "reverse": False,
    }

def set_param(effects, effect, param, value):
    for inst in effects:
        if inst["effect"] == effect:
            inst["params"][param] = {"value": value}
            return
    effects.append({"effect": effect, "enabled": True, "params": {param: {"value": value}}})

def warn_offline():
    print("control port closed; edited the .fcproj directly. Open it in FilmCraft to see it.", file=sys.stderr)

# ---------- commands ----------

def cmd_new(args, client):
    if client:
        created = client.execute("file.newProject", {"name": args.name})
        seq = client.execute("file.newSequence", {
            "name": args.sequence or args.name, "width": args.width, "height": args.height,
            "fps": args.fps, "video": args.video, "audio": args.audio,
        })
        saved = None
        if args.project:
            saved = client.execute("file.save", {"path": os.path.abspath(args.project)})
        emit({"via": "control", "project": created, "sequence": seq, "saved": saved})
        return
    if not args.project:
        fail("offline new needs -p PROJECT")
    warn_offline()
    project = blank_project(args.name, args.width, args.height, args.fps, args.video, args.audio, args.sequence)
    save_project(args, project, "fc new %s" % args.name)
    emit({"via": "file", "path": args.project, "sequence": project["view"]["active_sequence"]})

def probe_media(path):
    try:
        raw = subprocess.check_output(
            ["ffprobe", "-v", "error", "-show_format", "-show_streams", "-of", "json", path],
            stderr=subprocess.STDOUT,
        )
    except (OSError, subprocess.CalledProcessError) as e:
        fail("ffprobe failed (%s); pass --duration --width --height --fps" % e)
    return json.loads(raw)

def add_media_file(project, path, name, duration, width, height, fps, sample_rate, channels, size, no_audio, still):
    iid = alloc(project)
    name = name or os.path.basename(path.replace("\\", "/"))
    if fps:
        rate = {"num": int(fps[0]), "den": int(fps[1])}
    else:
        rate = {"num": 24000, "den": 1001}
    video = None
    if width and height and not (still is False and width is None):
        if width:
            video = {
                "width": width, "height": height, "frame_rate": rate, "par": [1, 1],
                "codec": "unknown", "pixel_format": "unknown",
                "color": {"matrix": "Bt709", "transfer": "Bt709", "primaries": "Bt709", "range": "Limited"},
                "has_alpha": False, "bitrate": None,
            }
    streams = []
    if not no_audio and channels:
        streams.append({"sample_rate": sample_rate or 48000, "channels": channels, "codec": "unknown", "bits_per_sample": None})
    kind = "Still" if still else ("AudioOnly" if video is None else "Movie")
    item = {
        "id": iid, "name": name, "label": "Iris",
        "kind": {"Media": {
            "media": {"File": {"path": path}},
            "info": {
                "name": name, "kind": kind, "duration": duration, "video": video,
                "audio_streams": streams, "container": "", "start_timecode": None, "file_size": size,
            },
            "interpret": {"frame_rate": None, "par": None, "ignore_alpha": False, "invert_alpha": False},
            "mark_in": None, "mark_out": None, "markers": [], "offline": False, "proxy": None,
        }},
        "metadata": {}, "created": iid,
    }
    project["project"]["items"][str(iid)] = item
    project["project"]["root"]["children"].append({"Item": iid})
    return iid

def cmd_import(args, client):
    paths = [os.path.abspath(p) if args.local else p for p in args.paths]
    if client:
        result = client.execute("file.import", {"paths": args.paths, "bin": args.bin} if args.bin else {"paths": args.paths})
        emit({"via": "control", **(result if isinstance(result, dict) else {"result": result})})
        return
    if not args.project:
        fail("offline import needs -p PROJECT")
    warn_offline()
    project = load_project(args.project)
    ids = []
    for path in paths:
        if args.duration is None and not args.probe:
            info = probe_media(args.probe or path)
        elif args.probe:
            info = probe_media(args.probe)
        else:
            info = None
        if info:
            dur = ticks(float(info["format"]["duration"]))
            v = next((s for s in info["streams"] if s["codec_type"] == "video"), None)
            a = next((s for s in info["streams"] if s["codec_type"] == "audio"), None)
            w = h = None
            fps = None
            if v:
                w, h = v["width"], v["height"]
                fps = v.get("r_frame_rate", "24/1").split("/")
                if len(fps) == 1:
                    fps.append("1")
            sr = int(a["sample_rate"]) if a else 48000
            ch = int(a["channels"]) if a else 0
            size = int(info["format"].get("size") or 0) or None
            still = v is not None and v.get("codec_name") in ("png", "mjpeg", "jpeg", "bmp", "gif", "webp", "tiff") and not a and float(info["format"].get("duration") or 0) <= 0.05
            ids.append(add_media_file(project, path, args.name, dur, w, h, fps, sr, ch, size, args.no_audio or not a, still))
        else:
            fps = str(Fraction(str(args.fps)).limit_denominator(1001)).split("/") if args.fps else ["24", "1"]
            if len(fps) == 1:
                fps.append("1")
            ids.append(add_media_file(
                project, path, args.name, ticks(args.duration), args.width, args.height, fps,
                args.sr, 0 if args.no_audio else args.channels, args.size, args.no_audio, False,
            ))
    save_project(args, project, "fc import %s" % ids)
    emit({"via": "file", "items": ids})

def place_offline(project, items, vtrack, atrack, at, dur, fill, gain, no_audio):
    seq, _ = active_sequence(project)
    fps = seq["settings"]["frame_rate"]
    video = find_track(seq, vtrack)
    audio = find_track(seq, atrack)
    t = ticks(at) if at is not None else max([c["start"] + c["duration"] for c in video["items"]] or [0])
    placed = []
    for item in items:
        src = project["project"]["items"][str(item)]["kind"]["Media"]["info"]
        length = snap(ticks(dur) if dur else src["duration"], fps)
        while src["duration"] and length > src["duration"]:
            length -= frame_ticks(fps)
        if length <= 0:
            fail("item %s has no duration to place" % item)
        link = alloc(project)
        vw = (src.get("video") or {}).get("width")
        if vw:
            sw = seq["settings"]["width"] / vw
            sh = seq["settings"]["height"] / src["video"]["height"]
            scale = (max if fill else min)(sw, sh) * 100
            effects = video_effects(seq["settings"]["width"], seq["settings"]["height"], (vw / 2, src["video"]["height"] / 2), round(scale, 4))
            clip = make_clip(project, item, snap(t, fps), length, 0, effects, link)
            video["items"].append(clip)
            placed.append(clip["id"])
            if src["audio_streams"] and not no_audio:
                aclip = make_clip(project, item, clip["start"], length, 0, audio_effects(), link)
                aclip["gain_db"] = gain
                audio["items"].append(aclip)
                placed.append(aclip["id"])
            else:
                clip["link"] = None
        else:
            aclip = make_clip(project, item, snap(t, fps), length, 0, audio_effects(), None)
            aclip["gain_db"] = gain
            audio["items"].append(aclip)
            placed.append(aclip["id"])
        t = snap(t, fps) + length
    return placed

def cmd_add(args, client):
    if client:
        params = {"items": args.items, "track": args.vtrack, "audioTrack": args.atrack, "video": True, "audio": not args.no_audio}
        if args.at is not None:
            params["seconds"] = args.at
        if args.dur is not None:
            params["duration"] = {"seconds": args.dur}
        result = client.execute("timeline.place", params)
        if args.clip_db:
            clips = (result or {}).get("clips") or []
            client.execute("clip.audioGain", {"clips": clips, "mode": "set", "db": args.clip_db})
        emit({"via": "control", "place": result})
        return
    if not args.project:
        fail("offline add-clips needs -p PROJECT")
    warn_offline()
    project = load_project(args.project)
    placed = place_offline(project, args.items, args.vtrack, args.atrack, args.at, args.dur, args.fill, args.clip_db, args.no_audio)
    save_project(args, project, "fc add-clips %s" % args.items)
    emit({"via": "file", "clips": placed})

def cmd_music(args, client):
    if client:
        result = client.execute("timeline.place", {
            "item": args.item, "track": args.track, "seconds": args.at, "video": False, "audio": True,
            "sourceIn": {"seconds": args.inp}, "duration": {"seconds": args.out - args.inp},
        })
        clips = (result or {}).get("clips") or []
        if args.db:
            client.execute("clip.audioGain", {"clips": clips, "mode": "set", "db": args.db})
        emit({"via": "control", "place": result})
        return
    if not args.project:
        fail("offline music needs -p PROJECT")
    warn_offline()
    project = load_project(args.project)
    seq, _ = active_sequence(project)
    fps = seq["settings"]["frame_rate"]
    track = find_track(seq, args.track)
    dur = snap(ticks(args.out - args.inp), fps)
    clip = make_clip(project, args.item, snap(ticks(args.at), fps), dur, snap(ticks(args.inp), fps), audio_effects(), None)
    clip["gain_db"] = args.db
    track["items"].append(clip)
    save_project(args, project, "fc music %s" % args.item)
    emit({"via": "file", "clip": clip["id"]})

def pick_track(info, name):
    video = not str(name).upper().startswith("A")
    pool = info.get("video" if video else "audio") or []
    for track in pool:
        short = track.get("name", "").replace("Video ", "V").replace("Audio ", "A")
        if track.get("name") == name or short == name or str(track.get("id")) == str(name):
            return track, video
    fail("no track %s" % name)

def cuts_of(track):
    clips = sorted(track["items"], key=lambda c: c["start"])
    out = []
    for a, b in zip(clips, clips[1:]):
        end = a.get("end", a["start"] + a["duration"])
        if end == b["start"]:
            out.append((a, b))
    return out

def cmd_transition(args, client):
    align = {"center": "center", "start": "start", "end": "end"}[args.align]
    if client:
        info = client.execute("sequence.inspect", {})
        track, video = pick_track(info, args.track)
        command = "sequence.applyVideoTransition" if video else "sequence.applyAudioTransition"
        made = []
        for _a, b in cuts_of(track):
            if args.at is not None and abs(b["start"] / TPS - args.at) > 0.02:
                continue
            made.append(client.execute(command, {
                "clip": b["clip"], "effect": args.effect, "frames": args.frames, "edge": "in", "align": align,
            }))
        emit({"via": "control", "transitions": made})
        return
    if not args.project:
        fail("offline transition needs -p PROJECT")
    warn_offline()
    project = load_project(args.project)
    seq, _ = active_sequence(project)
    track = find_track(seq, args.track)
    fps = seq["settings"]["frame_rate"]
    dur = snap(args.frames * frame_ticks(fps), fps)
    names = {"center": "CenterAtCut", "start": "StartAtCut", "end": "EndAtCut"}
    n = 0
    for a, b in cuts_of(track):
        if args.at is not None and b["start"] != snap(ticks(args.at), fps):
            continue
        track["transitions"] = [z for z in track["transitions"] if not (z["from"] == a["id"] and z["to"] == b["id"])]
        start = {"center": b["start"] - dur // 2, "start": b["start"], "end": b["start"] - dur}[args.align]
        track["transitions"].append(transition(project, start, dur, a["id"], b["id"], names[args.align], args.effect))
        n += 1
    save_project(args, project, "fc transition x%s" % n)
    emit({"via": "file", "count": n})

def cmd_fade(args, client):
    video = not args.track.upper().startswith("A")
    effect = args.effect or ("cross_dissolve" if video else "constant_power")
    command = "sequence.applyVideoTransition" if video else "sequence.applyAudioTransition"
    if client:
        info = client.execute("sequence.inspect", {})
        track, _video = pick_track(info, args.track)
        clips = sorted(track["items"], key=lambda c: c["start"])
        if not clips:
            fail("track empty")
        frames = max(1, int(round(args.dur * (info["settings"]["frame_rate"]["num"] / info["settings"]["frame_rate"]["den"]))))
        if args.direction == "in":
            result = client.execute(command, {"clip": clips[0]["clip"], "effect": effect, "frames": frames, "edge": "in", "align": "start"})
        else:
            result = client.execute(command, {"clip": clips[-1]["clip"], "effect": effect, "frames": frames, "edge": "out", "align": "end"})
        emit({"via": "control", "transition": result})
        return
    if not args.project:
        fail("offline fade needs -p PROJECT")
    warn_offline()
    project = load_project(args.project)
    seq, _ = active_sequence(project)
    track = find_track(seq, args.track)
    clips = sorted(track["items"], key=lambda c: c["start"])
    if not clips:
        fail("track empty")
    dur = snap(ticks(args.dur), seq["settings"]["frame_rate"])
    if args.direction == "in":
        c = clips[0]
        track["transitions"] = [z for z in track["transitions"] if not (z["from"] is None and z["to"] == c["id"])]
        track["transitions"].append(transition(project, c["start"], dur, None, c["id"], "StartAtCut", effect))
    else:
        c = clips[-1]
        end = c["start"] + c["duration"]
        track["transitions"] = [z for z in track["transitions"] if not (z["to"] is None and z["from"] == c["id"])]
        track["transitions"].append(transition(project, end - dur, dur, c["id"], None, "EndAtCut", effect))
    save_project(args, project, "fc fade %s" % args.direction)
    emit({"via": "file", "clip": c["id"]})


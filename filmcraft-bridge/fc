def cmd_export(args, client):
    if not client:
        fail("export needs FilmCraft listening on the control port")
    if args.open:
        client.execute("file.open", {"path": args.open})
    params = {
        "path": args.output, "format": args.format, "bitrateKbps": args.kbps, "bitrateMode": args.bitrate_mode,
        "audioCodec": args.audio_codec, "wait": False,
    }
    if args.end is not None:
        params.update(range="custom", startSeconds=args.start, endSeconds=args.end)
    started = client.execute("file.exportMedia", params)
    if not args.wait:
        emit({"via": "control", "export": started, "poll": "jobs.list"})
        return
    import time
    job_id = started.get("job") if isinstance(started, dict) else None
    deadline = time.time() + args.timeout
    while time.time() < deadline:
        listed = client.execute("jobs.list", {})
        jobs = listed if isinstance(listed, list) else (listed or {}).get("jobs") or []
        mine = [j for j in jobs if job_id is None or j.get("id") == job_id]
        if job_id is not None and not mine:
            time.sleep(args.poll)
            continue
        if mine and all(j.get("finished") for j in mine):
            bad = [j for j in mine if isinstance(j.get("result"), dict) and j["result"].get("error")]
            if bad:
                fail(bad[0]["result"]["error"])
            emit({"via": "control", "export": started, "jobs": mine})
            return
        time.sleep(args.poll)
    fail("export still running after %ss" % args.timeout)

